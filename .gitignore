# ================================
# Terraform (prevents 1GB+ provider binaries)
# ================================
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfvars.json
**/crash.log
**/crash.*.log

# ================================
# Python
# ================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ================================
# Node.js / React
# ================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build/
coverage/
.env.local
.env.development.local
.env.test.local
.env.production.local

# ================================
# Environment / Secrets
# ================================
.env
.env.*
*.pem
*.key

# ================================
# IDEs / OS
# ================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db